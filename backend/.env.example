# Supabase Postgres — two different connection strings, both from
# Supabase Dashboard → Project Settings → Database → Connection string.
#
# DATABASE_URL: this backend is a normal long-running Node/Express process
# (not serverless), so use the SESSION pooler (port 5432). Session mode
# gives each Prisma connection a stable backend connection for its whole
# lifetime, so prepared statements work fine — no "s0 already exists"
# collisions, no ?pgbouncer=true needed here.
DATABASE_URL="your-supabase-session-pooler-url"

# If you'd rather use the TRANSACTION pooler (port 6543) instead — e.g.
# because you'll later deploy this to a serverless platform — it does NOT
# support prepared statements, so you must append ?pgbouncer=true, which
# tells Prisma to stop using them:
# DATABASE_URL="your-supabase-transaction-pooler-url?pgbouncer=true"

# DIRECT_URL: the direct (non-pooled) connection, port 5432. Used only by
# the Prisma CLI for `migrate` / `db push` / `studio`.
DIRECT_URL="your-supabase-direct-connection-url"

# Any long random string works for a local/demo project.
JWT_SECRET="your-jwt-secret"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
